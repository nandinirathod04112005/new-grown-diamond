# SPA fallback — Apache / cPanel shared hosting.
#
# Same reason as public/_redirects: the routes are not files. Anything that is
# not a real file or directory is served index.html so the client router can
# read the path it was asked for.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite a request for something that actually exists on disk,
  # or the hashed asset files would be swallowed by the fallback too.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Hashed filenames change whenever their contents change, so they are safe to
# cache forever. index.html must never be, or visitors keep an old bundle that
# points at assets which no longer exist.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|png|jpg|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
