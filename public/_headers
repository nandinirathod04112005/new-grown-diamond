# Caching and basic safety headers — Netlify and Cloudflare Pages.
#
# /assets/ files carry a content hash in their names, so a changed file always
# has a new name: they can be cached for a year and never revalidated. Pages
# (the HTML) must NOT be cached like that, or a returning visitor would keep an
# old page pointing at assets that no longer exist after the next deploy.
# (vercel.json and public/.htaccess set the same rules for those hosts.)

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
