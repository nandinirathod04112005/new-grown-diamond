# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment — never commit real credentials.
# Only .env.example (placeholders) belongs in git.
.env
.env.*
!.env.example

# Playwright
tests-e2e/report
tests-e2e/screenshots
test-results

# Throwaway browser probes.
# Debugging this page means driving it in a real browser, and that leaves
# one-off scripts and screenshots in the working tree. They are never part of
# the deliverable — the suite's own screenshots go to tests-e2e/screenshots —
# so they are ignored rather than repeatedly cleaned up by hand.
/*probe*.mjs
/scratch-*.mjs
/*tmp*.mjs
/repro*.mjs
/drive*.mjs
/shot-*.png
/shots*/
